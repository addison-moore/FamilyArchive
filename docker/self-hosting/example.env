# FamilyArchive self-hosting configuration.
# Copy to .env next to docker-compose.yml (install.sh does this for you and
# fills in the secrets). Full reference:
# https://family-archive.net/docs/self-hosting/environment

# --- Required ---
# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Database password, used only inside the Docker network.
POSTGRES_PASSWORD=familyarchive

# --- Version pinning ---
# The compose file from a GitHub release defaults to that release's version.
# Uncomment to pin or upgrade explicitly (no leading "v" — e.g. 0.1.0), then:
#   docker compose pull && docker compose up -d
#FAMILYARCHIVE_VERSION=

# --- Common options ---
# Port the app is served on, and the public URL (set both when changing).
#APP_PORT=3000
#APP_URL=http://localhost:3000

# --- Optional features ---
# Email for invites and password resets (works without; links can be copied):
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=

# S3-compatible media storage instead of the local Docker volume:
#MEDIA_STORAGE_DRIVER=s3
#S3_ENDPOINT=
#S3_BUCKET=
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_REGION=auto
#S3_FORCE_PATH_STYLE=true

# OCR language for scanned documents. The published images bundle English
# only; other Tesseract languages currently require building the worker image
# from source (see the OCR docs).
#OCR_LANGUAGES=eng

# Upload limit and total storage quota (MB; quota 0 = unlimited):
#MEDIA_MAX_UPLOAD_MB=500
#MEDIA_QUOTA_MB=0
