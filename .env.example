# FamilyArchive environment configuration
# Copy to .env and adjust. Full reference: docs/self-hosting/environment.md

# --- Required ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Optional (defaults shown) ---
#APP_URL=http://localhost:3000
#APP_PORT=3000
#POSTGRES_USER=familyarchive
#POSTGRES_PASSWORD=familyarchive
#POSTGRES_DB=familyarchive

# Local development outside Docker (services from `docker compose up postgres valkey`)
#DATABASE_URL=postgres://familyarchive:familyarchive@localhost:5432/familyarchive
#REDIS_URL=redis://localhost:6379
# Host ports the dev compose publishes these on, bound to loopback. Change them
# if something already holds 5432/6379, and match them in the URLs above.
#POSTGRES_HOST_PORT=5432
#VALKEY_HOST_PORT=6379

# --- Storage (local driver is the default) ---
#MEDIA_STORAGE_DRIVER=local
#MEDIA_LOCAL_PATH=/data/media
#S3_ENDPOINT=
#S3_BUCKET=
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_REGION=auto
#S3_FORCE_PATH_STYLE=true

# --- SMTP (invite links work without it) ---
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=

# --- Audit log retention in days (0 = keep forever, the default) ---
#AUDIT_RETENTION_DAYS=0

# Largest single upload accepted, in MB.
#MEDIA_MAX_UPLOAD_MB=500
# Cap total media storage (originals + previews) in MB; 0 = unlimited.
#MEDIA_QUOTA_MB=0
# Bearer token enabling GET /api/admin/usage for external tooling (16+ chars).
#METRICS_TOKEN=

# Honour X-Forwarded-For / X-Real-IP when rate limiting sign-in and password
# reset. Leave this off unless a reverse proxy you control sets them — the
# headers are trivially spoofed by anyone reaching the app directly.
#TRUST_PROXY_HEADERS=false

# --- OCR (Tesseract language codes, "+"-separated) ---
#OCR_LANGUAGES=eng

# --- External AI providers (disabled by default) ---
# Enables the explicit "Clean up OCR with AI" action; never called implicitly.
#AI_PROVIDER=
#AI_API_KEY=
#AI_MODEL=
